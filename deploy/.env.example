# Required -- generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
BASE_URL=http://localhost:6130
# Dev only: allow login over plain http on a LAN IP (cookies unencrypted).
ALLOW_INSECURE_HTTP=false

# Observability (see docs/OBSERVABILITY.md)
OBS_METRICS_TOKEN=        # bearer token Prometheus uses for GET /metrics
GPU_AGENT_TOKEN=          # same value on every llm-gpu-agent host
# OBS_EXPORTERS=langfuse,signoz
# ENABLE_TELEMETRY=true

# Optional release pin and host port
# GATEWAY_TAG=0.14.0
# GATEWAY_PORT=6130
