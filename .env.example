# ============================================================================
# LLM Secure Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================================

# --- Required ---
AUTH_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=                        # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me       # Set a strong password

# --- Database ---
# DATABASE_URL=postgresql+asyncpg://gateway:password@postgres:5432/gateway_db  # Set in docker-compose
# POSTGRES_PASSWORD=password           # Used in docker-compose.prod.yml

# --- Optional: Performance ---
# REDIS_URL=redis://redis:6379/0       # Enable cross-worker rate limiting (falls back to in-process)
# PGBOUNCER_URL=                       # Enable PgBouncer connection pooling (falls back to direct DB)

# --- Optional: Compliance ---
# ENABLE_AUDIT_DB=false                # Persist audit events to DB (toggle in Settings UI)
# KEY_EXPIRY_DAYS=0                    # Auto-expire new keys after N days (0=disabled, toggle in Settings UI)

# --- Optional: Security ---
# FORCE_HTTPS=false                    # Enable HSTS header + Secure cookie flag

# --- Optional: Frontend ---
# BASE_URL=                            # Leave empty for relative URLs, or set to full URL (e.g., http://localhost:6130)

# --- Optional: Telemetry ---
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Optional: Email (SMTP) ---
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# EMAILS_FROM_EMAIL=admin@llmgateway.io
# EMAILS_FROM_NAME=LLM Gateway Admin
# ADMIN_EMAIL=superadmin@example.com

# --- Optional: Logging ---
# LOG_LEVEL=info
# SQL_ECHO=false                       # Enable SQLAlchemy query logging (dev only)
