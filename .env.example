# ============================================================================
# LLM Secure Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================================

# --- Required ---
AUTH_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=                        # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me       # Set a strong password

# --- Database ---
# DATABASE_URL=postgresql+asyncpg://gateway:password@postgres:5432/gateway_db  # Set in docker-compose
# POSTGRES_PASSWORD=password           # Used in docker-compose.prod.yml

# --- Optional: Performance ---
# REDIS_URL=redis://redis:6379/0       # Enable cross-worker rate limiting (falls back to in-process)
# PGBOUNCER_URL=                       # Enable PgBouncer connection pooling (falls back to direct DB)

# --- Optional: Compliance ---
# ENABLE_AUDIT_DB=false                # Persist audit events to DB (toggle in Settings UI)
# KEY_EXPIRY_DAYS=0                    # Auto-expire new keys after N days (0=disabled, toggle in Settings UI)

# --- Optional: Security ---
# FORCE_HTTPS=false                    # Enable HSTS header + Secure cookie flag
# WARNING: dev only -- cookies and passwords travel unencrypted. Lets login work over http://<lan-ip>.
# ALLOW_INSECURE_HTTP=false

# --- Optional: Frontend ---
# BASE_URL=                            # Leave empty for relative URLs, or set to full URL (e.g., http://localhost:6130)

# --- Optional: Telemetry (OFF by default) ---
# Master switch. While false the gateway creates no OTLP exporters at all, so an
# unreachable collector cannot produce "Connection refused" retry spam.
# ENABLE_TELEMETRY=false
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
# Inside Docker this must not be localhost -- use host.docker.internal or the
# collector's service name, otherwise it points back at the container itself.
# OTEL_EXPORTER_OTLP_ENDPOINT=
#
# --- Observability (v0.14.0) ---
# Sinks are a comma list of presets; each preset reads its vendor's own env names.
# Unset + ENABLE_TELEMETRY=true means "phoenix,otlp" (the old behaviour).
# OBS_EXPORTERS=phoenix,langfuse,signoz
# OBS_PROMETHEUS=true              # GET /metrics (pull, no ENABLE_TELEMETRY needed)
# OBS_METRICS_TOKEN=               # bearer token for /metrics (403 without it unless anonymous allowed)
# OBS_METRICS_ALLOW_ANONYMOUS=false
# OBS_METRICS_INTERVAL_S=60        # OTLP metric push interval
# OBS_TRACEMALLOC=false            # ~10-30% CPU while on; toggle from the admin page too
# OBS_FORCE_STREAM_USAGE=false     # add stream_options.include_usage for vllm/llamacpp
# OBS_POLL_INTERVAL=5              # model-server / GPU poll interval, seconds
# OBS_INSTANCE_ID=                 # defaults to the hostname (service.instance.id)
# GPU_AGENT_TOKEN=                 # shared bearer token for llm-gpu-agent (agent/README.md)

# preset: phoenix (self-hosted)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
# PHOENIX_PROJECT_NAME=llm-gateway
# preset: phoenix (Phoenix Cloud): endpoint includes /s/<space> if you use spaces
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# PHOENIX_API_KEY=
# preset: phoenix (Arize AX): setting ARIZE_SPACE_ID selects this mode
# ARIZE_SPACE_ID=
# ARIZE_API_KEY=
# ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces   # set the EU/CA host here if needed (verify)

# preset: langfuse
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# preset: langsmith
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=llm-gateway
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# preset: openobserve
# ZO_URL=http://localhost:5080
# ZO_USER=
# ZO_TOKEN=
# ZO_ORG=default
# ZO_STREAM=default

# preset: signoz (self-hosted collector on :4318; or cloud with the ingestion key)
# SIGNOZ_OTLP_ENDPOINT=http://localhost:4318
# SIGNOZ_INGESTION_KEY=
# SIGNOZ_REGION=us

# preset: grafana (Alloy/collector by default; Grafana Cloud when both are set)
# GRAFANA_OTLP_ENDPOINT=http://localhost:4318
# GRAFANA_OTLP_INSTANCE_ID=
# GRAFANA_OTLP_TOKEN=

# preset: datadog (local Datadog Agent with OTLP enabled)
# DD_OTLP_ENDPOINT=http://localhost:4318

# preset: honeycomb
# HONEYCOMB_API_KEY=
# HONEYCOMB_ENDPOINT=https://api.honeycomb.io

# preset: newrelic
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net

# preset: elastic
# ELASTIC_OTLP_ENDPOINT=
# ELASTIC_API_KEY=

# preset: otlp (generic: Jaeger, Tempo, any collector)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=

# --- Optional: Email (SMTP) ---
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# EMAILS_FROM_EMAIL=admin@llmgateway.io
# EMAILS_FROM_NAME=LLM Gateway Admin
# ADMIN_EMAIL=superadmin@example.com

# --- Optional: Logging ---
# LOG_LEVEL=info
# SQL_ECHO=false                       # Enable SQLAlchemy query logging (dev only)
